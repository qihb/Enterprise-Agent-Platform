# The document page runs without these values, but real saving is disabled.
# Configure only after local database preparation and driver installation are authorized.
# Never prefix server credentials with NEXT_PUBLIC_.
DATABASE_URL=
# Isolated databases accepted: eap_v1_local or eap_v1_test; local host only.
# Never use a PostgreSQL administrator as the application account.
DOCUMENT_STORAGE_DIR=
# Required: 64 hexadecimal characters for AES-256-GCM. Keep separate from data.
# Default file directory when unset: ~/.local/share/enterprise-agent-platform/documents
DOCUMENT_ENCRYPTION_KEY=
# CLI only; never used by the web application. No migration runs automatically.
DATABASE_MIGRATION_URL=
ALLOW_DATABASE_MIGRATION=
DEEPSEEK_API_KEY=
